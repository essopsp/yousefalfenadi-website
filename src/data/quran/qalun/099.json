{"number":99,"ayat":[{"a":1,"hafs":[1],"t":"إِذَا زُلْزِلَتِ اِ۬لْأَرْضُ زِلْزَالَهَا"},{"a":2,"hafs":[2],"t":"وَأَخْرَجَتِ اِ۬لْأَرْضُ أَثْقَالَهَا"},{"a":3,"hafs":[3],"t":"وَقَالَ اَ۬لْإِنسَٰنُ مَا لَهَا"},{"a":4,"hafs":[4],"t":"يَوْمَئِذٖ تُحَدِّثُ أَخْبَارَهَا"},{"a":5,"hafs":[5],"t":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَاۖ"},{"a":6,"hafs":[6],"t":"يَوْمَئِذٖ يَصْدُرُ اُ۬لنَّاسُ أَشْتَاتاٗ"},{"a":7,"hafs":[6],"t":"لِّيُرَوْاْ أَعْمَٰلَهُمْۖ"},{"a":8,"hafs":[7],"t":"فَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْراٗ يَرَهُۥۖ"},{"a":9,"hafs":[8],"t":"وَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٖ شَرّاٗ يَرَهُۥۖ"}]}
