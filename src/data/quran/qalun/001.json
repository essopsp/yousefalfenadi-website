{"number":1,"ayat":[{"a":1,"hafs":[1,2],"t":"اِ۬لْحَمْدُ لِلهِ رَبِّ اِ۬لْعَٰلَمِينَ"},{"a":2,"hafs":[3],"t":"اَ۬لرَّحْمَٰنِ اِ۬لرَّحِيمِ"},{"a":3,"hafs":[4],"t":"مَلِكِ يَوْمِ اِ۬لدِّينِۖ"},{"a":4,"hafs":[5],"t":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُۖ"},{"a":5,"hafs":[6],"t":"اُ۪هْدِنَا اَ۬لصِّرَٰطَ اَ۬لْمُسْتَقِيمَ"},{"a":6,"hafs":[7],"t":"صِرَٰطَ اَ۬لذِينَ أَنْعَمْتَ عَلَيْهِمْ"},{"a":7,"hafs":[7],"t":"غَيْرِ اِ۬لْمَغْضُوبِ عَلَيْهِمْ وَلَا اَ۬لضَّآلِّينَۖ"}]}
