{"number":87,"ayat":[{"a":1,"hafs":[1],"t":"سَبِّحِ اِ۪سْمَ رَبِّكَ اَ۬لْأَعْلَى"},{"a":2,"hafs":[2],"t":"اَ۬لذِے خَلَقَ فَسَوَّىٰ"},{"a":3,"hafs":[3],"t":"وَالذِے قَدَّرَ فَهَدَىٰ"},{"a":4,"hafs":[4],"t":"وَالذِے أَخْرَجَ اَ۬لْمَرْعَىٰ"},{"a":5,"hafs":[5],"t":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰۖ"},{"a":6,"hafs":[6],"t":"سَنُقْرِيـُٔكَ فَلَا تَنسَىٰ"},{"a":7,"hafs":[7],"t":"إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْفَىٰۖ"},{"a":8,"hafs":[8],"t":"وَنُيَسِّرُكَ لِلْيُسْرَىٰۖ"},{"a":9,"hafs":[9],"t":"فَذَكِّرْ إِن نَّفَعَتِ اِ۬لذِّكْرَىٰۖ"},{"a":10,"hafs":[10],"t":"سَيَذَّكَّرُ مَنْ يَّخْشَىٰ"},{"a":11,"hafs":[11],"t":"وَيَتَجَنَّبُهَا اَ۬لْأَشْقَى"},{"a":12,"hafs":[12],"t":"اَ۬لذِے يَصْلَى اَ۬لنَّارَ اَ۬لْكُبْرَىٰ"},{"a":13,"hafs":[13],"t":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰۖ"},{"a":14,"hafs":[14],"t":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ"},{"a":15,"hafs":[15],"t":"وَذَكَرَ اَ۪سْمَ رَبِّهِۦ فَصَلَّىٰۖ"},{"a":16,"hafs":[16],"t":"بَلْ تُؤْثِرُونَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْيَا"},{"a":17,"hafs":[17],"t":"وَالْأٓخِرَةُ خَيْرٞ وَأَبْقَىٰۖ"},{"a":18,"hafs":[18],"t":"إِنَّ هَٰذَا لَفِے اِ۬لصُّحُفِ اِ۬لْأُولَىٰ"},{"a":19,"hafs":[19],"t":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰۖ"}]}
