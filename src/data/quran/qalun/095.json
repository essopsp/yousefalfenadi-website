{"number":95,"ayat":[{"a":1,"hafs":[1],"t":"وَالتِّينِ وَالزَّيْتُونِ"},{"a":2,"hafs":[2],"t":"وَطُورِ سِينِينَ"},{"a":3,"hafs":[3],"t":"وَهَٰذَا اَ۬لْبَلَدِ اِ۬لْأَمِينِ"},{"a":4,"hafs":[4],"t":"لَقَدْ خَلَقْنَا اَ۬لْإِنسَٰنَ فِے أَحْسَنِ تَقْوِيمٖ"},{"a":5,"hafs":[5],"t":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ"},{"a":6,"hafs":[6],"t":"إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٖۖ"},{"a":7,"hafs":[7],"t":"فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِۖ"},{"a":8,"hafs":[8],"t":"أَلَيْسَ اَ۬للَّهُ بِأَحْكَمِ اِ۬لْحَٰكِمِينَۖ"}]}
