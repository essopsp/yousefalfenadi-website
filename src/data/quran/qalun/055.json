{"number":55,"ayat":[{"a":1,"hafs":[1,2],"t":"اِ۬لرَّحْمَٰنُ عَلَّمَ اَ۬لْقُرْءَانَۖ"},{"a":2,"hafs":[3,4],"t":"خَلَقَ اَ۬لْإِنسَٰنَ عَلَّمَهُ اُ۬لْبَيَانَۖ"},{"a":3,"hafs":[5],"t":"اَ۬لشَّمْسُ وَالْقَمَرُ بِحُسْبَانٖۖ"},{"a":4,"hafs":[6],"t":"وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَٰنِۖ"},{"a":5,"hafs":[7],"t":"وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ اَ۬لْمِيزَانَ"},{"a":6,"hafs":[8],"t":"أَلَّا تَطْغَوْاْ فِے اِ۬لْمِيزَانِ"},{"a":7,"hafs":[9],"t":"وَأَقِيمُواْ اُ۬لْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُواْ اُ۬لْمِيزَانَۖ"},{"a":8,"hafs":[10],"t":"وَالْأَرْضَ وَضَعَهَا لِلْأَنَامِ"},{"a":9,"hafs":[11],"t":"فِيهَا فَٰكِهَةٞ وَالنَّخْلُ ذَاتُ اُ۬لْأَكْمَامِ"},{"a":10,"hafs":[12],"t":"وَالْحَبُّ ذُو اُ۬لْعَصْفِ وَالرَّيْحَانُۖ"},{"a":11,"hafs":[13],"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"a":12,"hafs":[14],"t":"خَلَقَ اَ۬لْإِنسَٰنَ مِن صَلْصَٰلٖ كَالْفَخَّارِ"},{"a":13,"hafs":[15],"t":"وَخَلَقَ اَ۬لْجَآنَّ مِن مَّارِجٖ مِّن نَّارٖۖ"},{"a":14,"hafs":[16],"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"a":15,"hafs":[17],"t":"رَبُّ اُ۬لْمَشْرِقَيْنِ وَرَبُّ اُ۬لْمَغْرِبَيْنِۖ"},{"a":16,"hafs":[18],"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"a":17,"hafs":[19],"t":"مَرَجَ اَ۬لْبَحْرَيْنِ يَلْتَقِيَٰنِ"},{"a":18,"hafs":[20],"t":"بَيْنَهُمَا بَرْزَخٞ لَّا يَبْغِيَٰنِۖ"},{"a":19,"hafs":[21],"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"a":20,"hafs":[22],"t":"يُخْرَجُ مِنْهُمَا اَ۬للُّؤْلُؤُاْ وَالْمَرْجَانُۖ"},{"a":21,"hafs":[23],"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"a":22,"hafs":[24],"t":"وَلَهُ اُ۬لْجَوَارِ اِ۬لْمُنشَأَٰتُ فِے اِ۬لْبَحْرِ كَالْأَعْلَٰمِۖ"},{"a":23,"hafs":[25],"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"a":24,"hafs":[26],"t":"كُلُّ مَنْ عَلَيْهَا فَانٖ"},{"a":25,"hafs":[27],"t":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو اُ۬لْجَلَٰلِ وَالْإِكْرَامِۖ"},{"a":26,"hafs":[28],"t":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِۖ"},{"a":27,"hafs":[29],"t":"يَسْــَٔلُهُۥ مَن فِے اِ۬لسَّمَٰوَٰتِ وَالْأَرْضِ كُلَّ يَوْمٍ هُوَ فِے شَأْنٖۖ"},