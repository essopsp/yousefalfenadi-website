{"number":84,"ayat":[{"a":1,"hafs":[1],"t":"إِذَا اَ۬لسَّمَآءُ اُ۪نشَقَّتْ"},{"a":2,"hafs":[2],"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"a":3,"hafs":[3],"t":"وَإِذَا اَ۬لْأَرْضُ مُدَّتْ"},{"a":4,"hafs":[4],"t":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"a":5,"hafs":[5],"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْۖ"},{"a":6,"hafs":[6],"t":"يَٰأَيُّهَا اَ۬لْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحاٗ فَمُلَٰقِيهِۖ"},{"a":7,"hafs":[7],"t":"فَأَمَّا مَنْ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ"},{"a":8,"hafs":[8],"t":"فَسَوْفَ يُحَاسَبُ حِسَاباٗ يَسِيراٗ"},{"a":9,"hafs":[9],"t":"وَيَنقَلِبُ إِلَىٰ أَهْلِهِۦ مَسْرُوراٗۖ"},{"a":10,"hafs":[10],"t":"وَأَمَّا مَنْ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"},{"a":11,"hafs":[11],"t":"فَسَوْفَ يَدْعُواْ ثُبُوراٗ"},{"a":12,"hafs":[12],"t":"وَيُصَلَّىٰ سَعِيراًۖ"},{"a":13,"hafs":[13],"t":"إِنَّهُۥ كَانَ فِے أَهْلِهِۦ مَسْرُوراًۖ"},{"a":14,"hafs":[14],"t":"إِنَّهُۥ ظَنَّ أَن لَّنْ يَّحُورَ"},{"a":15,"hafs":[15],"t":"بَلَىٰۖ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيراٗۖ"},{"a":16,"hafs":[16],"t":"۞ فَلَا أُقْسِمُ بِالشَّفَقِ"},{"a":17,"hafs":[17],"t":"وَاليْلِ وَمَا وَسَقَ"},{"a":18,"hafs":[18],"t":"وَالْقَمَرِ إِذَا اَ۪تَّسَقَ"},{"a":19,"hafs":[19],"t":"لَتَرْكَبُنَّ طَبَقاً عَن طَبَقٖۖ"},{"a":20,"hafs":[20],"t":"فَمَا لَهُمْ لَا يُؤْمِنُونَ"},{"a":21,"hafs":[21],"t":"وَإِذَا قُرِےـَٔ عَلَيْهِمُ اُ۬لْقُرْءَانُ لَا يَسْجُدُونَۖ"},{"a":22,"hafs":[22],"t":"بَلِ اِ۬لذِينَ كَفَرُواْ يُكَذِّبُونَ"},{"a":23,"hafs":[23],"t":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَۖ"},{"a":24,"hafs":[24],"t":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍۖ"},{"a":25,"hafs":[25],"t":"إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونِۢۖ"}]}
