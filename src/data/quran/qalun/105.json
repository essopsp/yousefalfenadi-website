{"number":105,"ayat":[{"a":1,"hafs":[1],"t":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ اِ۬لْفِيلِۖ"},{"a":2,"hafs":[2],"t":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِے تَضْلِيلٖ"},{"a":3,"hafs":[3],"t":"وَأَرْسَلَ عَلَيْهِمْ طَيْراً أَبَابِيلَ"},{"a":4,"hafs":[4],"t":"تَرْمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ"},{"a":5,"hafs":[5],"t":"فَجَعَلَهُمْ كَعَصْفٖ مَّأْكُولِۢۖ"}]}
