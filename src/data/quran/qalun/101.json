{"number":101,"ayat":[{"a":1,"hafs":[1,2],"t":"اِ۬لْقَارِعَةُ مَا اَ۬لْقَارِعَةُۖ"},{"a":2,"hafs":[3],"t":"وَمَا أَدْرَيٰكَ مَا اَ۬لْقَارِعَةُۖ"},{"a":3,"hafs":[4],"t":"يَوْمَ يَكُونُ اُ۬لنَّاسُ كَالْفَرَاشِ اِ۬لْمَبْثُوثِ"},{"a":4,"hafs":[5],"t":"وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ اِ۬لْمَنفُوشِۖ"},{"a":5,"hafs":[6],"t":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ"},{"a":6,"hafs":[7],"t":"فَهْوَ فِے عِيشَةٖ رَّاضِيَةٖۖ"},{"a":7,"hafs":[8],"t":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ"},{"a":8,"hafs":[9],"t":"فَأُمُّهُۥ هَاوِيَةٞۖ"},{"a":9,"hafs":[10],"t":"وَمَا أَدْرَيٰكَ مَا هِيَهْۖ"},{"a":10,"hafs":[11],"t":"نَارٌ حَامِيَةُۢۖ"}]}
