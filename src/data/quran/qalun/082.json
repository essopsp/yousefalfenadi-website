{"number":82,"ayat":[{"a":1,"hafs":[1],"t":"إِذَا اَ۬لسَّمَآءُ اُ۪نفَطَرَتْ"},{"a":2,"hafs":[2],"t":"وَإِذَا اَ۬لْكَوَاكِبُ اُ۪نتَثَرَتْ"},{"a":3,"hafs":[3],"t":"وَإِذَا اَ۬لْبِحَارُ فُجِّرَتْ"},{"a":4,"hafs":[4],"t":"وَإِذَا اَ۬لْقُبُورُ بُعْثِرَتْ"},{"a":5,"hafs":[5],"t":"عَلِمَتْ نَفْسٞ مَّا قَدَّمَتْ وَأَخَّرَتْۖ"},{"a":6,"hafs":[6],"t":"يَٰأَيُّهَا اَ۬لْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ اَ۬لْكَرِيمِ"},{"a":7,"hafs":[7],"t":"اِ۬لذِے خَلَقَكَ فَسَوَّيٰكَ فَعَدَّلَكَ"},{"a":8,"hafs":[8],"t":"فِے أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَۖ"},{"a":9,"hafs":[9],"t":"كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ"},{"a":10,"hafs":[10],"t":"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ"},{"a":11,"hafs":[11],"t":"كِرَاماٗ كَٰتِبِينَ"},{"a":12,"hafs":[12],"t":"يَعْلَمُونَ مَا تَفْعَلُونَۖ"},{"a":13,"hafs":[13],"t":"إِنَّ اَ۬لْأَبْرَارَ لَفِے نَعِيمٖۖ"},{"a":14,"hafs":[14],"t":"وَإِنَّ اَ۬لْفُجَّارَ لَفِے جَحِيمٖ"},{"a":15,"hafs":[15],"t":"يَصْلَوْنَهَا يَوْمَ اَ۬لدِّينِ"},{"a":16,"hafs":[16],"t":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَۖ"},{"a":17,"hafs":[17],"t":"وَمَا أَدْرَيٰكَ مَا يَوْمُ اُ۬لدِّينِ"},{"a":18,"hafs":[18],"t":"ثُمَّ مَا أَدْرَيٰكَ مَا يَوْمُ اُ۬لدِّينِۖ"},{"a":19,"hafs":[19],"t":"يَوْمَ لَا تَمْلِكُ نَفْسٞ لِّنَفْسٖ شَيْــٔاٗۖ وَالْأَمْرُ يَوْمَئِذٖ لِّلهِۖ"}]}
