{"number":90,"ayat":[{"a":1,"hafs":[1],"t":"لَا أُقْسِمُ بِهَٰذَا اَ۬لْبَلَدِ"},{"a":2,"hafs":[2],"t":"وَأَنتَ حِلُّۢ بِهَٰذَا اَ۬لْبَلَدِ"},{"a":3,"hafs":[3],"t":"وَوَالِدٖ وَمَا وَلَدَ"},{"a":4,"hafs":[4],"t":"لَقَدْ خَلَقْنَا اَ۬لْإِنسَٰنَ فِے كَبَدٍۖ"},{"a":5,"hafs":[5],"t":"أَيَحْسِبُ أَن لَّنْ يَّقْدِرَ عَلَيْهِ أَحَدٞ"},{"a":6,"hafs":[6],"t":"يَقُولُ أَهْلَكْتُ مَالاٗ لُّبَداًۖ"},{"a":7,"hafs":[7],"t":"أَيَحْسِبُ أَن لَّمْ يَرَهُۥ أَحَدٌۖ"},{"a":8,"hafs":[8],"t":"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ"},{"a":9,"hafs":[9],"t":"وَلِسَاناٗ وَشَفَتَيْنِ"},{"a":10,"hafs":[10],"t":"وَهَدَيْنَٰهُ اُ۬لنَّجْدَيْنِۖ"},{"a":11,"hafs":[11],"t":"فَلَا اَ۪قْتَحَمَ اَ۬لْعَقَبَةَۖ"},{"a":12,"hafs":[12],"t":"وَمَا أَدْرَيٰكَ مَا اَ۬لْعَقَبَةُۖ"},{"a":13,"hafs":[13],"t":"فَكُّ رَقَبَةٍ"},{"a":14,"hafs":[14],"t":"أَوْ إِطْعَامٞ فِے يَوْمٖ ذِے مَسْغَبَةٖ"},{"a":15,"hafs":[15],"t":"يَتِيماٗ ذَا مَقْرَبَةٍ"},{"a":16,"hafs":[16],"t":"أَوْ مِسْكِيناٗ ذَا مَتْرَبَةٖۖ"},{"a":17,"hafs":[17],"t":"ثُمَّ كَانَ مِنَ اَ۬لذِينَ ءَامَنُواْ وَتَوَاصَوْاْ بِالصَّبْرِ وَتَوَاصَوْاْ بِالْمَرْحَمَةِۖ"},{"a":18,"hafs":[18],"t":"أُوْلَٰٓئِكَ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ"},{"a":19,"hafs":[19],"t":"وَالذِينَ كَفَرُواْ بِــَٔايَٰتِنَا هُمْ أَصْحَٰبُ اُ۬لْمَشْــَٔمَةِۖ"},{"a":20,"hafs":[20],"t":"عَلَيْهِمْ نَارٞ مُّوصَدَةُۢۖ"}]}
