{"number":75,"ayat":[{"a":1,"hafs":[1],"t":"لَا أُقْسِمُ بِيَوْمِ اِ۬لْقِيَٰمَةِ"},{"a":2,"hafs":[2],"t":"وَلَا أُقْسِمُ بِالنَّفْسِ اِ۬للَّوَّامَةِۖ"},{"a":3,"hafs":[3],"t":"أَيَحْسِبُ اُ۬لْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ"},{"a":4,"hafs":[4],"t":"بَلَىٰۖ قَٰدِرِينَ عَلَىٰ أَن نُّسَوِّيَ بَنَانَهُۥۖ"},{"a":5,"hafs":[5],"t":"بَلْ يُرِيدُ اُ۬لْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥۖ"},{"a":6,"hafs":[6],"t":"يَسْــَٔلُ أَيَّانَ يَوْمُ اُ۬لْقِيَٰمَةِۖ"},{"a":7,"hafs":[7],"t":"فَإِذَا بَرَقَ اَ۬لْبَصَرُ"},{"a":8,"hafs":[8],"t":"وَخَسَفَ اَ۬لْقَمَرُ"},{"a":9,"hafs":[9],"t":"وَجُمِعَ اَ۬لشَّمْسُ وَالْقَمَرُ"},{"a":10,"hafs":[10],"t":"يَقُولُ اُ۬لْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ اَ۬لْمَفَرُّۖ"},{"a":11,"hafs":[11],"t":"كَلَّا لَا وَزَرَۖ"},{"a":12,"hafs":[12],"t":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمُسْتَقَرُّۖ"},{"a":13,"hafs":[13],"t":"يُنَبَّؤُاْ اُ۬لْإِنسَٰنُ يَوْمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَۖ"},{"a":14,"hafs":[14],"t":"بَلِ اِ۬لْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٞ"},{"a":15,"hafs":[15],"t":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥۖ"},{"a":16,"hafs":[16,17],"t":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦۖ إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥۖ"},{"a":17,"hafs":[18],"t":"فَإِذَا قَرَأْنَٰهُ فَاتَّبِعْ قُرْءَانَهُۥ"},{"a":18,"hafs":[19],"t":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥۖ"},{"a":19,"hafs":[20],"t":"كَلَّا بَلْ تُحِبُّونَ اَ۬لْعَاجِلَةَ"},{"a":20,"hafs":[21],"t":"وَتَذَرُونَ اَ۬لْأٓخِرَةَۖ"},{"a":21,"hafs":[22],"t":"وُجُوهٞ يَوْمَئِذٖ نَّاضِرَةٌ"},{"a":22,"hafs":[23],"t":"إِلَىٰ رَبِّهَا نَاظِرَةٞۖ"},{"a":23,"hafs":[24],"t":"وَوُجُوهٞ يَوْمَئِذِۢ بَاسِرَةٞ"},{"a":24,"hafs":[25],"t":"تَظُنُّ أَنْ يُّفْعَلَ بِهَا فَاقِرَةٞۖ"},{"a":25,"hafs":[26],"t":"كَلَّا إِذَا بَلَغَتِ اِ۬لتَّرَاقِيَ"},{"a":26,"hafs":[27],"t":"وَقِيلَ مَن رَّاقٖ"},{"a":27,"hafs":[28],"t":"وَظَنَّ أَنَّهُ اُ۬لْفِرَاقُ"},{"a":28,"hafs":[29],"t":"وَالْتَفَّتِ اِ۬لسَّاقُ بِالسَّاقِ"},{"a":29,"hafs":[30],"t":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمَسَاقُۖ"},{"a":30,"hafs":[31],"t":"فَلَا صَدَّقَ وَلَا صَلَّىٰۖ"},{"a":31,"hafs":[32],"t":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰۖ"},{"a":32,"hafs":[33],"t":"ثُمَّ ذَهَبَ إِلَىٰ أَهْلِهِۦ يَتَمَطَّىٰۖ"},{"a":33,"hafs":[34],"t":"أَوْلَىٰ لَكَ فَأَوْلَىٰ"},{"a":34,"hafs":[35],"t":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰۖ"},{"a":35,"hafs":[36],"t":"أَيَحْسِبُ اُ۬لْإِنسَٰنُ أَنْ يُّتْرَكَ سُدىًۖ"},{"a":36,"hafs":[37],"t":"أَلَمْ يَكُ نُطْفَةٗ مِّن مَّنِيّٖ تُمْنَىٰ"},{"a":37,"hafs":[38],"t":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ"},{"a":38,"hafs":[39],"t":"فَجَعَلَ مِنْهُ اُ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ وَالْأُنثَىٰۖ"},{"a":39,"hafs":[40],"t":"أَلَيْسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰ أَنْ يُّحْـِۧيَ اَ۬لْمَوْتَىٰۖ"}]}
