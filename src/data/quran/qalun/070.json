{"number":70,"ayat":[{"a":1,"hafs":[1],"t":"سَالَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ"},{"a":2,"hafs":[2],"t":"لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٞ"},{"a":3,"hafs":[3],"t":"مِّنَ اَ۬للَّهِ ذِے اِ۬لْمَعَارِجِۖ"},{"a":4,"hafs":[4],"t":"تَعْرُجُ اُ۬لْمَلَٰٓئِكَةُ وَالرُّوحُ إِلَيْهِ فِے يَوْمٖ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٖۖ"},{"a":5,"hafs":[5],"t":"فَاصْبِرْ صَبْراٗ جَمِيلاًۖ"},{"a":6,"hafs":[6],"t":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيداٗ"},{"a":7,"hafs":[7],"t":"وَنَرَيٰهُ قَرِيباٗۖ"},{"a":8,"hafs":[8],"t":"يَوْمَ تَكُونُ اُ۬لسَّمَآءُ كَالْمُهْلِ"},{"a":9,"hafs":[9],"t":"وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ"},{"a":10,"hafs":[10],"t":"وَلَا يَسْــَٔلُ حَمِيمٌ حَمِيماٗ"},{"a":11,"hafs":[11],"t":"يُبَصَّرُونَهُمْۖ يَوَدُّ اُ۬لْمُجْرِمُ لَوْ يَفْتَدِے مِنْ عَذَابِ يَوْمَئِذِۢ بِبَنِيهِ"},{"a":12,"hafs":[12],"t":"وَصَٰحِبَتِهِۦ وَأَخِيهِ"},{"a":13,"hafs":[13],"t":"وَفَصِيلَتِهِ اِ۬لتِے تُــْٔوِيهِ"},{"a":14,"hafs":[14],"t":"وَمَن فِے اِ۬لْأَرْضِ جَمِيعاٗ ثُمَّ يُنجِيهِ"},{"a":15,"hafs":[15],"t":"كَلَّاۖ إِنَّهَا لَظَىٰ"},{"a":16,"hafs":[16],"t":"نَزَّاعَةٞ لِّلشَّوَىٰ"},{"a":17,"hafs":[17],"t":"تَدْعُواْ مَنْ أَدْبَرَ وَتَوَلَّىٰ"},{"a":18,"hafs":[18],"t":"وَجَمَعَ فَأَوْعَىٰۖ"},{"a":19,"hafs":[19],"t":"۞ إِنَّ اَ۬لْإِنسَٰنَ خُلِقَ هَلُوعاً"},{"a":20,"hafs":[20],"t":"إِذَا مَسَّهُ اُ۬لشَّرُّ جَزُوعاٗ"},{"a":21,"hafs":[21],"t":"وَإِذَا مَسَّهُ اُ۬لْخَيْرُ مَنُوعاً"},{"a":22,"hafs":[22],"t":"إِلَّا اَ۬لْمُصَلِّينَ"},{"a":23,"hafs":[23],"t":"اَ۬لذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَۖ"},{"a":24,"hafs":[24],"t":"وَالذِينَ فِے أَمْوَٰلِهِمْ حَقّٞ مَّعْلُومٞ"},{"a":25,"hafs":[25],"t":"لِّلسَّآئِلِ وَالْمَحْرُومِۖ"},{"a":26,"hafs":[26],"t":"وَالذِينَ يُصَدِّقُونَ بِيَوْمِ اِ۬لدِّينِۖ"},{"a":27,"hafs":[27],"t":"وَالذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ"},{"a":28,"hafs":[28],"t":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٖۖ"},{"a":29,"hafs":[29],"t":"وَالذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ"},{"a":30,"hafs":[30],"t":"إِلَّا عَلَىٰ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَۖ"},{"a":31,"hafs":[31],"t":"فَمَنِ اِ۪بْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ اُ۬لْعَادُونَۖ"},{"a":32,"hafs":[32],"t":"وَالذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَۖ"},{"a":33,"hafs":[33],"t":"وَالذِينَ هُم بِشَهَٰدَتِهِمْ قَآئِمُونَۖ"},{"a":34,"hafs":[34],"t":"وَالذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"},{"a":35,"hafs":[35],"t":"أُوْلَٰٓئِكَ فِے جَنَّٰتٖ مُّكْرَمُونَۖ"},{"a":36,"hafs":[36],"t":"فَمَالِ اِ۬لذِينَ كَفَرُواْ قِبَلَكَ مُهْطِعِينَ"},{"a":37,"hafs":[37],"t":"عَنِ اِ۬لْيَمِينِ وَعَنِ اِ۬لشِّمَالِ عِزِينَۖ"},{"a":38,"hafs":[38],"t":"أَيَطْمَعُ كُلُّ اُ۪مْرِےٕٖ مِّنْهُمْ أَنْ يُّدْخَلَ جَنَّةَ نَعِيمٖ"},{"a":39,"hafs":[39],"t":"كَلَّاۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَۖ"},{"a":40,"hafs":[40],"t":"۞ فَلَا أُقْسِمُ بِرَبِّ اِ۬لْمَشَٰرِقِ وَالْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ"},{"a":41,"hafs":[41],"t":"عَلَىٰ أَن نُّبَدِّلَ خَيْراٗ مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَۖ"},{"a":42,"hafs":[42],"t":"فَذَرْهُمْ يَخُوضُواْ وَيَلْعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوْمَهُمُ اُ۬لذِے يُوعَدُونَ"},{"a":43,"hafs":[43],"t":"يَوْمَ يَخْرُجُونَ مِنَ اَ۬لْأَجْدَاثِ سِرَاعاٗ كَأَنَّهُمْ إِلَىٰ نَصْبٖ يُوفِضُونَ"},{"a":44,"hafs":[44],"t":"خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٞۖ ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لذِے كَانُواْ يُوعَدُونَۖ"}]}
