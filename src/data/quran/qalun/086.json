{"number":86,"ayat":[{"a":1,"hafs":[1],"t":"وَالسَّمَآءِ وَالطَّارِقِ"},{"a":2,"hafs":[2],"t":"وَمَا أَدْرَيٰكَ مَا اَ۬لطَّارِقُ"},{"a":3,"hafs":[3],"t":"اُ۬لنَّجْمُ اُ۬لثَّاقِبُ"},{"a":4,"hafs":[4],"t":"إِن كُلُّ نَفْسٖ لَّمَا عَلَيْهَا حَافِظٞۖ"},{"a":5,"hafs":[5],"t":"فَلْيَنظُرِ اِ۬لْإِنسَٰنُ مِمَّ خُلِقَۖ"},{"a":6,"hafs":[6],"t":"خُلِقَ مِن مَّآءٖ دَافِقٖ"},{"a":7,"hafs":[7],"t":"يَخْرُجُ مِنۢ بَيْنِ اِ۬لصُّلْبِ وَالتَّرَآئِبِۖ"},{"a":8,"hafs":[8],"t":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٞ"},{"a":9,"hafs":[9],"t":"يَوْمَ تُبْلَى اَ۬لسَّرَآئِرُ"},{"a":10,"hafs":[10],"t":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖۖ"},{"a":11,"hafs":[11],"t":"وَالسَّمَآءِ ذَاتِ اِ۬لرَّجْعِ"},{"a":12,"hafs":[12],"t":"وَالْأَرْضِ ذَاتِ اِ۬لصَّدْعِ"},{"a":13,"hafs":[13],"t":"إِنَّهُۥ لَقَوْلٞ فَصْلٞ"},{"a":14,"hafs":[14],"t":"وَمَا هُوَ بِالْهَزْلِۖ"},{"a":15,"hafs":[15],"t":"إِنَّهُمْ يَكِيدُونَ كَيْداٗ"},{"a":16,"hafs":[16],"t":"وَأَكِيدُ كَيْداٗۖ"},{"a":17,"hafs":[17],"t":"فَمَهِّلِ اِ۬لْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْداَۢۖ"}]}
