{"number":96,"ayat":[{"a":1,"hafs":[1],"t":"اِ۪قْرَأْ بِاسْمِ رَبِّكَ اَ۬لذِے خَلَقَۖ"},{"a":2,"hafs":[2],"t":"خَلَقَ اَ۬لْإِنسَٰنَ مِنْ عَلَقٍۖ"},{"a":3,"hafs":[3],"t":"اِ۪قْرَأْ وَرَبُّكَ اَ۬لْأَكْرَمُ"},{"a":4,"hafs":[4],"t":"اُ۬لذِے عَلَّمَ بِالْقَلَمِ"},{"a":5,"hafs":[5],"t":"عَلَّمَ اَ۬لْإِنسَٰنَ مَا لَمْ يَعْلَمْۖ"},{"a":6,"hafs":[6],"t":"كَلَّا إِنَّ اَ۬لْإِنسَٰنَ لَيَطْغَىٰ"},{"a":7,"hafs":[7],"t":"أَن رَّءَاهُ اُ۪سْتَغْنَىٰۖ"},{"a":8,"hafs":[8],"t":"إِنَّ إِلَىٰ رَبِّكَ اَ۬لرُّجْعَىٰۖ"},{"a":9,"hafs":[9],"t":"أَرَٰ۬يْتَ اَ۬لذِے يَنْهَىٰ"},{"a":10,"hafs":[10],"t":"عَبْداً إِذَا صَلَّىٰۖ"},{"a":11,"hafs":[11],"t":"أَرَٰ۬يْتَ إِن كَانَ عَلَى اَ۬لْهُدَىٰ"},{"a":12,"hafs":[12],"t":"أَوْ أَمَرَ بِالتَّقْوَىٰۖ"},{"a":13,"hafs":[13],"t":"أَرَٰ۬يْتَ إِن كَذَّبَ وَتَوَلَّىٰ"},{"a":14,"hafs":[14],"t":"أَلَمْ يَعْلَم بِأَنَّ اَ۬للَّهَ يَرَىٰۖ"},{"a":15,"hafs":[15],"t":"كَلَّا لَئِن لَّمْ يَنتَهِ"},{"a":16,"hafs":[15],"t":"لَنَسْفَعاَۢ بِالنَّاصِيَةِ"},{"a":17,"hafs":[16],"t":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِيـَٔةٖۖ"},{"a":18,"hafs":[17],"t":"فَلْيَدْعُ نَادِيَهُۥ"},{"a":19,"hafs":[18],"t":"سَنَدْعُ اُ۬لزَّبَانِيَةَۖ"},{"a":20,"hafs":[19],"t":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبۖ"}]}
